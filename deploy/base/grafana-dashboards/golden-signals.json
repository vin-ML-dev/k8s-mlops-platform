{
  "annotations": { "list": [] },
  "editable": true,
  "schemaVersion": 39,
  "title": "MLOps Platform — Golden Signals",
  "tags": ["mlops", "golden-signals"],
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Gateway — Request Rate (traffic)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(gateway_requests_total[5m]))",
          "legendFormat": "requests/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Gateway — Error Ratio (errors)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(gateway_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(gateway_requests_total[5m])), 1)",
          "legendFormat": "5xx ratio",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Gateway — Upstream Latency p50 / p95 / p99 (latency)",
      "description": "Model-call latency measured by the gateway. Values fixed at 10s can mean 10s or longer until the gateway histogram defines buckets above 10s.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(gateway_upstream_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(gateway_upstream_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(gateway_upstream_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 4,
      "title": "Gateway — Cache Hit Ratio",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(gateway_cache_hits_total[5m])) / clamp_min(sum(rate(gateway_requests_total[5m])), 1)",
          "legendFormat": "cache hit ratio",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Model — Available Replicas (saturation)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_available{namespace=\"mlops\", deployment=\"llama-cpp\"}",
          "legendFormat": "model replicas",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Gateway — Available Replicas (HPA saturation)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 16 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_available{namespace=\"mlops\", deployment=\"gateway\"}",
          "legendFormat": "gateway replicas",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Agent — Heartbeat Age (dead-man)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 120 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "time() - max(monitoring_agent_heartbeat_timestamp_seconds)",
          "legendFormat": "heartbeat age (s)",
          "refId": "A"
        }
      ]
    }
  ]
}
